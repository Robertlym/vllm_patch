+    async def _abort_all(self, request_ids: List[str]) -> None:
+        for rid in request_ids:
+            try:
+                await self.engine_client.abort(rid)
+            except Exception:
+                # Best-effort abort; ignore errors (e.g., already finished)
+                pass
+
+    async def _wrap_with_timeout(self,
+                                 iterator: AsyncIterator,
+                                 request_ids: List[str],
+                                 timeout_s: Optional[int]) -> AsyncIterator:
+        """Wrap an async iterator, enforcing an overall deadline.
+
+        If the deadline elapses, abort provided request_ids and raise
+        asyncio.TimeoutError to the caller.
+        """
+        if timeout_s is None or timeout_s <= 0:
+            # No timeout; return original iterator
+            async for item in iterator:
+                yield item
+            return
+
+        start_ts = time.monotonic()
+        deadline = start_ts + float(timeout_s)
+
+        # Pull items with remaining-time budget per next()
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                await self._abort_all(request_ids)
+                raise asyncio.TimeoutError("request timed out")
+            try:
+                next_item = await asyncio.wait_for(iterator.__anext__(),
+                                                   timeout=remaining)
+            except StopAsyncIteration:
+                return
+            except asyncio.TimeoutError:
+                await self._abort_all(request_ids)
+                raise
+            yield next_item
 
